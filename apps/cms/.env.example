# Postgres connection string.
# Local Docker stack (docker-compose.yml at the repo root) listens on 5434.
# This machine already runs PostgreSQL 17 on 5432 and PostgreSQL 13 on 5433,
# so the container deliberately avoids both.
#   docker compose up -d
# Production: any Postgres 15+ (Neon, Supabase, RDS, …).
DATABASE_URI=postgresql://postgres:150205@localhost:5434/holisticai

# Signing secret for Payload auth. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
