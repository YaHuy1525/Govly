# ── Convex (attribution backend) ─────────────────────────────
# From `npx convex dev`, or the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=
# Only needed for CI / non-interactive deploys (npx convex deploy).
CONVEX_DEPLOY_KEY=

# ── HubSpot (lead sync) ──────────────────────────────────────
# HubSpot → Settings → Integrations → Private Apps → your app → Auth tab.
# Must be a PRIVATE APP token (pat-eu1-… for EU portals, pat-na1-… for NA).
# Required scope: crm.objects.contacts.write  (add .read to dedupe by email)
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_REGION=eu1

# ── Upstash Redis (rate limiting) ────────────────────────────
# Without these the limiter falls back to in-memory, which is per-instance and
# therefore ineffective on serverless / multi-instance deploys.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Admin ────────────────────────────────────────────────────
# Shared secret for the form-admin endpoints. Generate: openssl rand -hex 24
FORMS_ADMIN_TOKEN=
