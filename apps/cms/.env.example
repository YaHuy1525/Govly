# Postgres connection string.
# Local Docker stack (docker-compose.yml at the repo root) listens on 5433:
#   docker compose up -d
# Production: any Postgres 15+ (Neon, Supabase, RDS, …).
DATABASE_URI=postgresql://postgres:150205@localhost:5433/holisticai

# Signing secret for Payload auth. Generate: openssl rand -hex 32
PAYLOAD_SECRET=
